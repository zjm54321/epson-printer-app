+    choicestr = NULL;
+    if (x == y)
+    {
+      switch (x)
+      {
+        case 60:  choicestr = "60x60dpi";   break;
+        case 120: choicestr = "120x72dpi";  break;
+        case 180: choicestr = "180x180dpi"; break;
+        case 360: choicestr = "360x216dpi"; break;
+      }
+    }
+    option = ppdFindOption(job_data->ppd, "Resolution");
